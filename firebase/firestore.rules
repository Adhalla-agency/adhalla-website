rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data;
    }

    function enabled() {
      return signedIn()
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid))
        && accessDoc().enabled == true;
    }

    function staff() {
      return enabled()
        && accessDoc().role in ['adhalla_admin', 'adhalla_operator'];
    }

    function canReadClient(clientId) {
      return enabled()
        && (staff() || clientId in accessDoc().allowed_clients);
    }

    // Kasutaja võib lugeda ainult enda autoriseerimisprofiili.
    match /portalUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // V1 kliendiportaal on kliendi jaoks täielikult read-only.
    match /clients/{clientId} {
      allow read: if canReadClient(clientId);
      allow write: if false;

      match /{document=**} {
        allow read: if canReadClient(clientId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
